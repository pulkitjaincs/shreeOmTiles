generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  SALESMAN
  DRIVER
  ACCOUNTANT
  SUPERVISOR
}

enum PartyCategory {
  RETAIL
  CONTRACTOR
  ARCHITECT
  WHOLESALER
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  CONVERTED
  EXPIRED
}

enum ExpenseCategory {
  FUEL_TRANSPORT
  LABOUR_HAMALI
  RENT_GODOWN
  ELECTRICITY_UTILITIES
  SALARY_ADVANCE
  PANTRY_REFRESHMENTS
  MAINTENANCE_REPAIRS
  MARKETING_SAMPLE
  OTHER
}

enum InvoiceStatus {
  DRAFT
  CREATED
  PAID
  PARTIAL
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  CREDIT
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  OUT_FOR_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum WarehouseType {
  WAREHOUSE
  SHOWROOM
}

enum CreditType {
  RECEIVABLE
  PAYABLE
}

enum CreditStatus {
  UNPAID
  PARTIAL
  SETTLED
  OVERDUE
}

enum PaymentType {
  INFLOW
  OUTFLOW
}

model User {
  id                String            @id @default(uuid())
  name              String
  phone             String            @unique
  passwordHash      String
  role              Role              @default(SALESMAN)
  scope             String?           // e.g. Warehouse ID
  isActive          Boolean           @default(true)
  pushToken         String?           // Expo Push Notification Token
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  invoices          Invoice[]
  refundInvoices    RefundInvoice[]   @relation("UserRefundInvoices")
  paymentsConfirmed Payment[]         @relation("ConfirmedPayments")
  deliveries        Delivery[]        @relation("DriverDeliveries")
  supervisedDeliveries DeliverySupervisor[]
  auditLogs         AuditLog[]
  purchases         Purchase[]        @relation("UserPurchases")
  quotations        Quotation[]       @relation("UserQuotations")
  expenses          Expense[]         @relation("UserExpenses")

  @@index([role, isActive])
  @@index([createdAt])
}

model Warehouse {
  id           String         @id @default(uuid())
  name         String
  address      String
  type         WarehouseType  @default(WAREHOUSE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  
  stockLedgers       StockLedger[]
  invoiceItems       InvoiceItem[]
  refundInvoiceItems RefundInvoiceItem[]
  purchaseItems      PurchaseItem[]
}

model Product {
  id            String         @id @default(uuid())
  category      String
  name          String
  attributes    Json           @default("{}") // JSONB in postgres
  hsnCode       String?
  unit          String         @default("box") // box, sqft, piece, set
  minStockAlert Int            @default(10)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  stockLedgers       StockLedger[]
  invoiceItems       InvoiceItem[]
  refundInvoiceItems RefundInvoiceItem[]
  quotationItems     QuotationItem[]
  purchaseItems      PurchaseItem[]

  @@index([category])
  @@index([name])
  @@index([isActive])
}

model StockLedger {
  id          String     @id @default(uuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  batchNo     String?
  quantity    Decimal    @default(0) @db.Decimal(12, 2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([productId])
  @@index([warehouseId])
}

model Party {
  id            String         @id @default(uuid())
  name          String
  phone         String
  address       String?
  gstin         String?
  category      PartyCategory  @default(RETAIL)
  isSaved       Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  invoices       Invoice[]
  refundInvoices RefundInvoice[]
  payments       Payment[]
  creditLedgers  CreditLedger[]
  purchases      Purchase[]
  quotations     Quotation[]
  debitNotes     DebitNote[]

  @@index([phone])
  @@index([name])
  @@index([isSaved, name])
}

model InvoiceSequence {
  id            String   @id @default(uuid())
  financialYear String   @unique // e.g. "2425", "2526"
  lastNumber    Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id               String         @id @default(uuid())
  invoiceNo        String         @unique
  partyId          String
  party            Party          @relation(fields: [partyId], references: [id])
  salesmanId       String
  salesman         User           @relation(fields: [salesmanId], references: [id])
  status           InvoiceStatus  @default(CREATED)
  taxBreakup       Json           @default("{}") // { cgst: 0, sgst: 0, igst: 0, rate: 18 }
  subtotal         Decimal        @default(0) @db.Decimal(12, 2)
  tax              Decimal        @default(0) @db.Decimal(12, 2)
  taxRate          Decimal        @default(0) @db.Decimal(5, 2)
  transportCost    Decimal        @default(0) @db.Decimal(12, 2)
  transportGstRate Decimal        @default(0) @db.Decimal(5, 2)
  transportTax     Decimal        @default(0) @db.Decimal(12, 2)
  itemsTax         Decimal        @default(0) @db.Decimal(12, 2)
  total            Decimal        @default(0) @db.Decimal(12, 2)
  paymentMode      PaymentMode?
  notes            String?
  quotationId      String?
  quotation        Quotation?     @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items          InvoiceItem[]
  refundInvoices RefundInvoice[]
  payments       Payment[]
  deliveries     Delivery[]
  creditLedgers  CreditLedger[]

  @@index([partyId])
  @@index([salesmanId])
  @@index([createdAt])
  @@index([partyId, status])
  @@index([status, createdAt])
}

model InvoiceItem {
  id          String     @id @default(uuid())
  invoiceId   String
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  batchNo     String?
  qty         Decimal    @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal    @db.Decimal(12, 2)
  discount    Decimal    @default(0) @db.Decimal(12, 2)
  total       Decimal    @default(0) @db.Decimal(12, 2)
  createdAt   DateTime   @default(now())

  @@index([invoiceId])
  @@index([productId])
  @@index([warehouseId])
}

model Payment {
  id              String         @id @default(uuid())
  invoiceId       String?
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  refundInvoiceId String?
  refundInvoice   RefundInvoice? @relation(fields: [refundInvoiceId], references: [id], onDelete: SetNull)
  purchaseId      String?
  purchase        Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  partyId         String?
  party           Party?         @relation(fields: [partyId], references: [id], onDelete: SetNull)
  mode            PaymentMode
  amount          Decimal        @db.Decimal(12, 2)
  upiTxnRef       String?
  upiUtr          String?
  confirmedById   String?
  confirmedBy     User?          @relation("ConfirmedPayments", fields: [confirmedById], references: [id])
  status          PaymentStatus  @default(PENDING)
  type            PaymentType    @default(INFLOW)
  notes           String?
  paidAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([partyId])
  @@index([invoiceId])
  @@index([purchaseId])
  @@index([status, type, paidAt])
  @@index([confirmedById])
  @@index([createdAt])
}

model CreditLedger {
  id              String         @id @default(uuid())
  partyId         String
  party           Party          @relation(fields: [partyId], references: [id], onDelete: Cascade)
  invoiceId       String?
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  refundInvoiceId String?
  refundInvoice   RefundInvoice? @relation(fields: [refundInvoiceId], references: [id], onDelete: SetNull)
  purchaseId      String?
  purchase        Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  amountDue       Decimal        @db.Decimal(12, 2)
  dueDate         DateTime?
  type            CreditType     @default(RECEIVABLE)
  notes           String?
  status          CreditStatus   @default(UNPAID)
  remindersSent   Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([partyId])
  @@index([invoiceId])
  @@index([purchaseId])
  @@index([partyId, status, type])
  @@index([type, status, amountDue])
  @@index([createdAt])
}

model Delivery {
  id                 String         @id @default(uuid())
  invoiceId          String
  invoice            Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  driverId           String?
  driver             User?          @relation("DriverDeliveries", fields: [driverId], references: [id])
  status             DeliveryStatus @default(PENDING)
  notes              String?
  items              Json?          @default("[]")
  amountToCollect    Decimal        @default(0) @db.Decimal(12, 2)
  cashCollected      Decimal?       @default(0) @db.Decimal(12, 2)
  cashCollectedAt    DateTime?
  cashHandedOver     Boolean        @default(false)
  cashHandedOverAt   DateTime?
  cashHandedOverToId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  trips              DeliveryTrip[]
  supervisors        DeliverySupervisor[]

  @@index([invoiceId])
  @@index([driverId, status])
  @@index([cashHandedOver, cashCollected])
  @@index([createdAt])
}

model DeliverySupervisor {
  id           String    @id @default(uuid())
  deliveryId   String
  delivery     Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  supervisorId String
  supervisor   User      @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  assignedAt   DateTime  @default(now())

  @@unique([deliveryId, supervisorId])
  @@index([deliveryId])
  @@index([supervisorId])
}

model DeliveryTrip {
  id          String    @id @default(uuid())
  deliveryId  String
  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  tripNo      Int       @default(1)
  vehicle     String?
  cost        Decimal   @default(0) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deliveryId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  diff      Json     @default("{}")
  timestamp DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([timestamp])
}

model RefundSequence {
  id            String   @id @default(uuid())
  financialYear String   @unique // e.g. "2425", "2526"
  lastNumber    Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model RefundInvoice {
  id                String              @id @default(uuid())
  refundNo          String              @unique // e.g. "RF-2425-0001"
  originalInvoiceId String
  originalInvoice   Invoice             @relation(fields: [originalInvoiceId], references: [id], onDelete: Cascade)
  partyId           String
  party             Party               @relation(fields: [partyId], references: [id])
  createdById       String
  createdBy         User                @relation("UserRefundInvoices", fields: [createdById], references: [id])
  
  subtotal          Decimal             @default(0) @db.Decimal(12, 2)
  tax               Decimal             @default(0) @db.Decimal(12, 2)
  total             Decimal             @default(0) @db.Decimal(12, 2)
  taxBreakup        Json                @default("{}") // { cgst, sgst, igst, rate, isInterState }
  refundMode        PaymentMode         @default(CASH)
  reason            String?
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  items             RefundInvoiceItem[]
  payments          Payment[]
  creditLedgers     CreditLedger[]

  @@index([originalInvoiceId])
  @@index([partyId])
  @@index([createdAt])
}

model RefundInvoiceItem {
  id              String        @id @default(uuid())
  refundInvoiceId String
  refundInvoice   RefundInvoice @relation(fields: [refundInvoiceId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  warehouseId     String?
  warehouse       Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  batchNo         String?
  qty             Decimal       @default(1) @db.Decimal(12, 2)
  unitPrice       Decimal       @db.Decimal(12, 2)
  taxRate         Decimal       @default(18) @db.Decimal(5, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())

  @@index([refundInvoiceId])
  @@index([productId])
  @@index([warehouseId])
}

model CompanySetting {
  id           String   @id @default("default")
  upiId        String?
  merchantName String?  @default("Dhra Tiles & Sanitary")
  upiAccounts  Json?    @default("[]")
  updatedAt    DateTime @updatedAt
}

// ---------------- NEW PROCUREMENT & VYAPAR MODELS ----------------

model PurchaseSequence {
  id            String   @id @default(uuid())
  financialYear String   @unique // e.g. "2627"
  lastNumber    Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model ExpenseSequence {
  id            String   @id @default(uuid())
  financialYear String   @unique // e.g. "2627"
  lastNumber    Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model DebitNoteSequence {
  id            String   @id @default(uuid())
  financialYear String   @unique // e.g. "2627"
  lastNumber    Int      @default(0)
  updatedAt     DateTime @updatedAt
}


model Purchase {
  id            String         @id @default(uuid())
  purchaseNo    String         @unique // e.g. "PUR-2627-0001"
  vendorBillNo  String?
  partyId       String
  party         Party          @relation(fields: [partyId], references: [id])
  createdById   String
  createdBy     User           @relation("UserPurchases", fields: [createdById], references: [id])
  status        InvoiceStatus  @default(CREATED)
  taxRate       Decimal        @default(0) @db.Decimal(5, 2)
  subtotal      Decimal        @default(0) @db.Decimal(12, 2)
  tax           Decimal        @default(0) @db.Decimal(12, 2)
  transportCost Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @default(0) @db.Decimal(12, 2)
  paymentMode   PaymentMode?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items         PurchaseItem[]
  debitNotes    DebitNote[]
  payments      Payment[]
  creditLedgers CreditLedger[]

  @@index([partyId])
  @@index([createdById])
  @@index([createdAt])
}

model PurchaseItem {
  id          String     @id @default(uuid())
  purchaseId  String
  purchase    Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  batchNo     String?
  qty         Decimal    @default(0) @db.Decimal(12, 2)
  unitPrice   Decimal    @db.Decimal(12, 2)
  discount    Decimal    @default(0) @db.Decimal(12, 2)
  total       Decimal    @default(0) @db.Decimal(12, 2)
  createdAt   DateTime   @default(now())

  @@index([purchaseId])
  @@index([productId])
  @@index([warehouseId])
}

model QuotationSequence {
  id            String   @id @default(uuid())
  financialYear String   @unique // e.g. "2627"
  lastNumber    Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNo     String          @unique // e.g. "EST-2627-0001"
  partyId         String?
  party           Party?          @relation(fields: [partyId], references: [id], onDelete: SetNull)
  customerName    String?
  customerPhone   String?
  customerAddress String?
  createdById     String
  createdBy       User            @relation("UserQuotations", fields: [createdById], references: [id])
  status          QuotationStatus @default(SENT)
  validUntil      DateTime?
  subtotal        Decimal         @default(0) @db.Decimal(12, 2)
  taxRate         Decimal         @default(18) @db.Decimal(5, 2)
  tax             Decimal         @default(0) @db.Decimal(12, 2)
  transportCost   Decimal         @default(0) @db.Decimal(12, 2)
  transportGstRate Decimal        @default(0) @db.Decimal(5, 2)
  total           Decimal         @default(0) @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           QuotationItem[]
  invoices        Invoice[]

  @@index([partyId])
  @@index([createdAt])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty         Decimal   @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal   @db.Decimal(12, 2)
  discount    Decimal   @default(0) @db.Decimal(12, 2)
  total       Decimal   @default(0) @db.Decimal(12, 2)

  @@index([quotationId])
}

model Expense {
  id          String          @id @default(uuid())
  expenseNo   String          @unique // e.g. "EXP-2627-0001"
  category    ExpenseCategory @default(OTHER)
  amount      Decimal         @db.Decimal(12, 2)
  paymentMode PaymentMode     @default(CASH)
  paidTo      String?
  notes       String?
  createdById String
  createdBy   User            @relation("UserExpenses", fields: [createdById], references: [id])
  expenseDate DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category])
  @@index([expenseDate])
}

model DebitNote {
  id          String    @id @default(uuid())
  debitNoteNo String    @unique // e.g. "DN-2627-0001"
  purchaseId  String
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  partyId     String
  party       Party     @relation(fields: [partyId], references: [id])
  amount      Decimal   @db.Decimal(12, 2)
  reason      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([purchaseId])
  @@index([partyId])
}

